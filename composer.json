{
    "name": "wilycode/database-model",
    "description": "Attribute-based PHP database models with metadata, JSON hydration, relationships and change tracking.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\Database\\Model\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\Database\\Model\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/phpunit.xml",
            "/CHANGELOG.md",
            "/CONTRIBUTING.md",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/composer.lock"
        ]
    },
    "homepage": "https://github.com/wilycode/database-model",
    "keywords": [
        "wilycode",
        "database",
        "model",
        "hydration",
        "attributes",
        "relationships",
        "change-tracking",
        "orm"
    ],
    "support": {
        "issues": "https://github.com/wilycode/database-model/issues",
        "source": "https://github.com/wilycode/database-model"
    }
}
